# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Signs access tokens. At least 32 bytes; generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Open only while you create the first account, then set it back to false.
OPEN_REGISTRATION=false

# The assistant's key. Leave empty and the app still runs — only /api/ai/chat
# refuses, with ai_not_configured.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_BASE_URL=https://api.anthropic.com

# Local database. In production these point at the managed instance instead.
DB_NAME=aether
DB_USERNAME=aether
DB_PASSWORD=aether

# Where the app is published on your machine.
WEB_PORT=3000
